# ==============================================================================
# Apna Route – Backend Environment Configuration (.env.example)
# IMPORTANT: Copy this file to '.env' and fill in your Supabase credentials.
# NEVER commit your real '.env' file or secret keys to version control.
# ==============================================================================

# Supabase Project Settings -> API
# 1. Project URL (e.g. https://abcdefghijklm.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Publishable / Anon public key (safe for client queries governed by RLS)
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here

# 3. Optional: Flask server port
PORT=5000
FLASK_DEBUG=1
